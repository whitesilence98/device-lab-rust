{
  "name": "device-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Windows device explorer — Electron, React, TypeScript and Rust",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:backend": "node scripts/build-backend.cjs",
    "build:ui": "tsc -p tsconfig.json && tsc -p electron/tsconfig.json && vite build --base=./",
    "build": "npm run build:backend && npm run build:ui",
    "start": "npm run build && electron .",
    "start:ui": "npm run build:ui && electron .",
    "test": "tsc -p electron/tsconfig.json && node --test dist-electron/core.test.js",
    "check": "tsc -p tsconfig.json && tsc -p electron/tsconfig.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
